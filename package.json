{
  "name": "concordia-ics-builder",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:host": "sudo nixos-firewall-tool open tcp 5173 && vite dev --host",
    "build": "vite build",
    "preview": "pnpm run build && wrangler pages dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "deploy": "pnpm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types && mv worker-configuration.d.ts src/"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@sveltejs/adapter-auto": "^3.2.5",
    "@sveltejs/adapter-cloudflare": "^5.0.0",
    "@sveltejs/enhanced-img": "0.4.4",
    "@sveltejs/kit": "^2.5.28",
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "@types/eslint": "^9.6.1",
    "@typescript-eslint/parser": "^8.6.0",
    "autoprefixer": "^10.4.20",
    "bits-ui": "1.0.0-next.77",
    "clsx": "^2.1.1",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-perfectionist": "4.6.0",
    "eslint-plugin-svelte": "^2.44.0",
    "globals": "^15.9.0",
    "lucide-svelte": "0.471.0",
    "prettier": "^3.3.3",
    "prettier-eslint": "^16.3.0",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-svelte": "^3.2.6",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "svelte": "5.17.4",
    "svelte-check": "^4.0.2",
    "tailwind-merge": "^2.5.2",
    "tailwind-variants": "0.3.0",
    "tailwindcss": "^3.4.12",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.6.0",
    "vite": "6.0.7",
    "wrangler": "^3.101.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.5.5",
    "@sveltejs/adapter-static": "^3.0.5",
    "ical-generator": "^8.0.0",
    "mode-watcher": "0.5.0",
    "nanoid": "^5.0.7",
    "svelte-sonner": "^0.3.28",
    "tesseract.js": "6.0.0",
    "timezones-ical-library": "^1.8.3"
  }
}